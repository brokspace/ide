{
  "private": true,
  "name": "brokspace-ide-product-ext",
  "version": "0.3.0",
  "description": "Brokspace IDE branding: welcome page, about dialog, help menu",
  "dependencies": {
    "@theia/ai-registry": "1.76.0",
    "@theia/core": "1.76.0",
    "@theia/getting-started": "1.76.0",
    "@theia/vsx-registry": "1.76.0",
    "@theia/workspace": "1.76.0",
    "inversify": "^6.2.2"
  },
  "devDependencies": {
    "rimraf": "^2.7.1",
    "tslint": "^5.20.1",
    "typescript": "~5.9.3"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/brokspace-frontend-module",
      "electronMain": "lib/electron-main/brokspace-main-module",
      "backend": "lib/node/brokspace-backend-module"
    }
  ],
  "keywords": [
    "theia-extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brokspace/ide.git"
  },
  "bugs": {
    "url": "https://github.com/brokspace/ide/issues"
  },
  "homepage": "https://brokspace.org",
  "files": [
    "lib",
    "src",
    "i18n"
  ],
  "scripts": {
    "clean": "rimraf lib *.tsbuildinfo",
    "build": "tsc -b",
    "lint": "eslint --ext js,jsx,ts,tsx src",
    "lint:fix": "eslint --ext js,jsx,ts,tsx src --fix",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "author": "Brokspace contributors"
}
