{
  "$schema": "vscode://schemas/color-theme",
  "name": "Brokspace Dark",
  "type": "dark",
  "colors": {
    "foreground": "#D9DEE6",
    "descriptionForeground": "#A7B0BC",
    "errorForeground": "#FF6B6B",
    "focusBorder": "#FF8A3D99",
    "selection.background": "#FF8A3D55",
    "icon.foreground": "#A7B0BC",
    "widget.border": "#2C333D",
    "widget.shadow": "#00000066",
    "textLink.foreground": "#FFA66E",
    "textLink.activeForeground": "#FF8A3D",
    "textCodeBlock.background": "#1E232B",
    "textBlockQuote.background": "#14181E",
    "textBlockQuote.border": "#FF8A3D",
    "textPreformat.foreground": "#FFC7A3",

    "editor.background": "#0B0E12",
    "editor.foreground": "#D9DEE6",
    "editorLineNumber.foreground": "#3A424D",
    "editorLineNumber.activeForeground": "#A7B0BC",
    "editorCursor.foreground": "#FF8A3D",
    "editor.selectionBackground": "#FF8A3D40",
    "editor.inactiveSelectionBackground": "#FF8A3D22",
    "editor.selectionHighlightBackground": "#FF8A3D1F",
    "editor.wordHighlightBackground": "#A7B0BC1F",
    "editor.findMatchBackground": "#FF8A3D66",
    "editor.findMatchHighlightBackground": "#FF8A3D2E",
    "editor.lineHighlightBackground": "#14181E",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#1E232B",
    "editorIndentGuide.activeBackground1": "#47515C",
    "editorWhitespace.foreground": "#2C333D",
    "editorBracketMatch.background": "#FF8A3D22",
    "editorBracketMatch.border": "#FF8A3D88",
    "editorGutter.background": "#0B0E12",
    "editorGutter.addedBackground": "#4CAF7D",
    "editorGutter.modifiedBackground": "#FF8A3D",
    "editorGutter.deletedBackground": "#FF6B6B",
    "editorWidget.background": "#14181E",
    "editorWidget.border": "#2C333D",
    "editorSuggestWidget.background": "#14181E",
    "editorSuggestWidget.border": "#2C333D",
    "editorSuggestWidget.selectedBackground": "#1E232B",
    "editorSuggestWidget.highlightForeground": "#FF8A3D",
    "editorHoverWidget.background": "#14181E",
    "editorHoverWidget.border": "#2C333D",
    "editorError.foreground": "#FF6B6B",
    "editorWarning.foreground": "#F5C26B",
    "editorInfo.foreground": "#82B4FF",
    "editorOverviewRuler.border": "#00000000",
    "editorGroupHeader.tabsBackground": "#0B0E12",
    "editorGroup.border": "#1E232B",
    "minimap.background": "#0B0E12",
    "scrollbarSlider.background": "#47515C55",
    "scrollbarSlider.hoverBackground": "#47515C88",
    "scrollbarSlider.activeBackground": "#FF8A3D66",

    "tab.activeBackground": "#0B0E12",
    "tab.activeForeground": "#F8F9FF",
    "tab.activeBorderTop": "#FF8A3D",
    "tab.inactiveBackground": "#0F1318",
    "tab.inactiveForeground": "#7D8794",
    "tab.border": "#0B0E12",
    "tab.hoverBackground": "#14181E",

    "activityBar.background": "#0B0E12",
    "activityBar.foreground": "#F8F9FF",
    "activityBar.inactiveForeground": "#5C6672",
    "activityBar.activeBorder": "#FF8A3D",
    "activityBar.border": "#14181E",
    "activityBarBadge.background": "#FF8A3D",
    "activityBarBadge.foreground": "#0B0E12",

    "sideBar.background": "#0F1318",
    "sideBar.foreground": "#C7CED9",
    "sideBar.border": "#14181E",
    "sideBarTitle.foreground": "#A7B0BC",
    "sideBarSectionHeader.background": "#14181E",
    "sideBarSectionHeader.foreground": "#A7B0BC",
    "sideBarSectionHeader.border": "#1E232B",

    "list.activeSelectionBackground": "#1E232B",
    "list.activeSelectionForeground": "#F8F9FF",
    "list.inactiveSelectionBackground": "#181D24",
    "list.hoverBackground": "#14181E",
    "list.focusOutline": "#FF8A3D88",
    "list.highlightForeground": "#FF8A3D",
    "tree.indentGuidesStroke": "#2C333D",

    "statusBar.background": "#0B0E12",
    "statusBar.foreground": "#A7B0BC",
    "statusBar.border": "#14181E",
    "statusBar.noFolderBackground": "#0B0E12",
    "statusBar.debuggingBackground": "#FF8A3D",
    "statusBar.debuggingForeground": "#0B0E12",
    "statusBarItem.hoverBackground": "#1E232B",
    "statusBarItem.remoteBackground": "#FF8A3D",
    "statusBarItem.remoteForeground": "#0B0E12",

    "titleBar.activeBackground": "#0B0E12",
    "titleBar.activeForeground": "#C7CED9",
    "titleBar.inactiveBackground": "#0B0E12",
    "titleBar.inactiveForeground": "#5C6672",
    "titleBar.border": "#14181E",
    "menu.background": "#14181E",
    "menu.foreground": "#D9DEE6",
    "menu.selectionBackground": "#1E232B",
    "menu.selectionForeground": "#F8F9FF",
    "menu.separatorBackground": "#2C333D",
    "menubar.selectionBackground": "#1E232B",

    "panel.background": "#0B0E12",
    "panel.border": "#1E232B",
    "panelTitle.activeBorder": "#FF8A3D",
    "panelTitle.activeForeground": "#F8F9FF",
    "panelTitle.inactiveForeground": "#7D8794",

    "input.background": "#14181E",
    "input.foreground": "#F8F9FF",
    "input.border": "#2C333D",
    "input.placeholderForeground": "#5C6672",
    "inputOption.activeBorder": "#FF8A3D",
    "dropdown.background": "#14181E",
    "dropdown.border": "#2C333D",
    "checkbox.background": "#14181E",
    "checkbox.border": "#2C333D",

    "button.background": "#FF8A3D",
    "button.foreground": "#0B0E12",
    "button.hoverBackground": "#FFA66E",
    "button.secondaryBackground": "#1E232B",
    "button.secondaryForeground": "#F8F9FF",
    "button.secondaryHoverBackground": "#2C333D",
    "badge.background": "#FF8A3D",
    "badge.foreground": "#0B0E12",
    "progressBar.background": "#FF8A3D",

    "quickInput.background": "#14181E",
    "quickInputList.focusBackground": "#1E232B",
    "pickerGroup.foreground": "#FF8A3D",
    "pickerGroup.border": "#2C333D",
    "notifications.background": "#14181E",
    "notifications.border": "#2C333D",
    "notificationLink.foreground": "#FFA66E",

    "terminal.background": "#0B0E12",
    "terminal.foreground": "#D9DEE6",
    "terminalCursor.foreground": "#FF8A3D",
    "terminal.ansiBlack": "#14181E",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#9FD3A8",
    "terminal.ansiYellow": "#F5C26B",
    "terminal.ansiBlue": "#82B4FF",
    "terminal.ansiMagenta": "#E58FB6",
    "terminal.ansiCyan": "#8FD1E6",
    "terminal.ansiWhite": "#D9DEE6",
    "terminal.ansiBrightBlack": "#5C6672",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#B7E3BF",
    "terminal.ansiBrightYellow": "#FFD58F",
    "terminal.ansiBrightBlue": "#A7CAFF",
    "terminal.ansiBrightMagenta": "#F0B0CF",
    "terminal.ansiBrightCyan": "#B3E3F1",
    "terminal.ansiBrightWhite": "#F8F9FF",

    "gitDecoration.modifiedResourceForeground": "#FFA66E",
    "gitDecoration.untrackedResourceForeground": "#9FD3A8",
    "gitDecoration.deletedResourceForeground": "#FF6B6B",
    "gitDecoration.ignoredResourceForeground": "#47515C",
    "gitDecoration.conflictingResourceForeground": "#E58FB6",

    "diffEditor.insertedTextBackground": "#4CAF7D22",
    "diffEditor.removedTextBackground": "#FF6B6B22",
    "peekView.border": "#FF8A3D",
    "peekViewEditor.background": "#0F1318",
    "peekViewResult.background": "#14181E",
    "peekViewTitle.background": "#14181E"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5C6672", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "#FF8A3D" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#9FD3A8" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#F5C26B" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#82B4FF" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#8FD1E6" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"], "settings": { "foreground": "#D9DEE6" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#C7CED9" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#E4C8B3" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#FFA66E", "fontStyle": "italic" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#A7B0BC" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml"], "settings": { "foreground": "#FF8A3D" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#F5C26B" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#E58FB6" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#E58FB6" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#FF8A3D", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#FFC7A3" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#82B4FF" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9FD3A8" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#FF6B6B" } },
    { "scope": ["invalid"], "settings": { "foreground": "#FF6B6B" } }
  ],
  "semanticHighlighting": true
}
