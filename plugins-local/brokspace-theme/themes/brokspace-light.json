{
  "$schema": "vscode://schemas/color-theme",
  "name": "Brokspace Light",
  "type": "light",
  "colors": {
    "foreground": "#1E232B",
    "descriptionForeground": "#47515C",
    "errorForeground": "#C62828",
    "focusBorder": "#D9561A99",
    "selection.background": "#FF8A3D44",
    "icon.foreground": "#47515C",
    "widget.border": "#D9DEE6",
    "widget.shadow": "#0B0E1222",
    "textLink.foreground": "#A8410F",
    "textLink.activeForeground": "#83330F",
    "textCodeBlock.background": "#EEF0F5",
    "textBlockQuote.background": "#EEF0F5",
    "textBlockQuote.border": "#FF8A3D",
    "textPreformat.foreground": "#83330F",

    "editor.background": "#FFFFFF",
    "editor.foreground": "#1E232B",
    "editorLineNumber.foreground": "#A7B0BC",
    "editorLineNumber.activeForeground": "#47515C",
    "editorCursor.foreground": "#D9561A",
    "editor.selectionBackground": "#FF8A3D40",
    "editor.inactiveSelectionBackground": "#FF8A3D22",
    "editor.selectionHighlightBackground": "#FF8A3D1F",
    "editor.findMatchBackground": "#FF8A3D66",
    "editor.findMatchHighlightBackground": "#FF8A3D2E",
    "editor.lineHighlightBackground": "#F8F9FF",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#EEF0F5",
    "editorIndentGuide.activeBackground1": "#A7B0BC",
    "editorBracketMatch.background": "#FF8A3D22",
    "editorBracketMatch.border": "#D9561A88",
    "editorGutter.addedBackground": "#2E7D4F",
    "editorGutter.modifiedBackground": "#D9561A",
    "editorGutter.deletedBackground": "#C62828",
    "editorWidget.background": "#F8F9FF",
    "editorWidget.border": "#D9DEE6",
    "editorSuggestWidget.highlightForeground": "#A8410F",
    "editorGroupHeader.tabsBackground": "#F8F9FF",
    "editorGroup.border": "#EEF0F5",

    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#0B0E12",
    "tab.activeBorderTop": "#FF8A3D",
    "tab.inactiveBackground": "#F8F9FF",
    "tab.inactiveForeground": "#5C6672",
    "tab.border": "#EEF0F5",

    "activityBar.background": "#F8F9FF",
    "activityBar.foreground": "#0B0E12",
    "activityBar.inactiveForeground": "#7D8794",
    "activityBar.activeBorder": "#FF8A3D",
    "activityBar.border": "#EEF0F5",
    "activityBarBadge.background": "#FF8A3D",
    "activityBarBadge.foreground": "#0B0E12",

    "sideBar.background": "#F8F9FF",
    "sideBar.foreground": "#1E232B",
    "sideBar.border": "#EEF0F5",
    "sideBarSectionHeader.background": "#EEF0F5",
    "sideBarSectionHeader.foreground": "#47515C",

    "list.activeSelectionBackground": "#FFE4D1",
    "list.activeSelectionForeground": "#0B0E12",
    "list.inactiveSelectionBackground": "#EEF0F5",
    "list.hoverBackground": "#EEF0F5",
    "list.highlightForeground": "#A8410F",

    "statusBar.background": "#F8F9FF",
    "statusBar.foreground": "#47515C",
    "statusBar.border": "#EEF0F5",
    "statusBarItem.hoverBackground": "#EEF0F5",
    "statusBarItem.remoteBackground": "#FF8A3D",
    "statusBarItem.remoteForeground": "#0B0E12",

    "titleBar.activeBackground": "#F8F9FF",
    "titleBar.activeForeground": "#1E232B",
    "titleBar.border": "#EEF0F5",
    "menu.selectionBackground": "#FFE4D1",
    "menubar.selectionBackground": "#EEF0F5",

    "panel.background": "#FFFFFF",
    "panel.border": "#EEF0F5",
    "panelTitle.activeBorder": "#FF8A3D",

    "input.background": "#FFFFFF",
    "input.border": "#D9DEE6",
    "input.placeholderForeground": "#7D8794",
    "inputOption.activeBorder": "#D9561A",

    "button.background": "#FF8A3D",
    "button.foreground": "#0B0E12",
    "button.hoverBackground": "#F2701F",
    "button.secondaryBackground": "#EEF0F5",
    "button.secondaryForeground": "#1E232B",
    "badge.background": "#FF8A3D",
    "badge.foreground": "#0B0E12",
    "progressBar.background": "#FF8A3D",
    "pickerGroup.foreground": "#A8410F",

    "terminal.foreground": "#1E232B",
    "terminalCursor.foreground": "#D9561A",

    "gitDecoration.modifiedResourceForeground": "#A8410F",
    "gitDecoration.untrackedResourceForeground": "#2E7D4F",
    "gitDecoration.deletedResourceForeground": "#C62828",
    "gitDecoration.ignoredResourceForeground": "#A7B0BC"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7D8794", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "#A8410F" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#2E7D4F" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#8A5A00" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#1F5FBF" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#0E7490" } },
    { "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#1E232B" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#2C333D" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#6B4423" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#A8410F", "fontStyle": "italic" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#47515C" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#A8410F" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8A5A00" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#9C2F6B" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#9C2F6B" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#A8410F", "fontStyle": "bold" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#83330F" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#2E7D4F" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#C62828" } },
    { "scope": ["invalid"], "settings": { "foreground": "#C62828" } }
  ],
  "semanticHighlighting": true
}
